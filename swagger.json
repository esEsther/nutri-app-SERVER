{
  "openapi": "3.0.3",
  "info": {
    "title": "Nutri-App API",
    "version": "1.0.0",
    "description": "Documentación Swagger/OpenAPI completa para Nutri-App SERVER"
  },
  "servers": [
    { "url": "http://localhost:7001" }
  ],
  "paths": {

    "/admin/crearArticulo": {
      "post": {
        "summary": "Crear un artículo",
        "tags": ["Admin - Artículos"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": { "type": "string", "maxLength": 150 },
                  "contenido": { "type": "string", "maxLength": 15000 },
                  "imagen": { "type": "string", "format": "binary" }
                },
                "required": ["titulo","contenido"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Artículo añadido correctamente",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "msg": "Artículo añadido correctamente",
                  "data": {
                    "id_articulo": 1,
                    "titulo": "Beneficios de la nutrición",
                    "contenido": "Contenido del artículo...",
                    "imagen_url": "uploads/articulo1.jpg"
                  }
                }
              }
            }
          },
          "401": { "description": "Ya existe un artículo con este título" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

"/admin/articulo/{id}": {
      "get": {
        "summary": "Obtener artículo por ID",
        "tags": ["Admin - Artículos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Artículo encontrado",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "titulo": "Beneficios de la nutrición",
                  "contenido": "Contenido completo del artículo...",
                  "imagen": "uploads/articulo1.jpg"
                }
              }
            }
          },
          "404": { "description": "Artículo no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/eliminarArticulo/{id}": {
      "delete": {
        "summary": "Eliminar artículo",
        "tags": ["Admin - Artículos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Artículo eliminado correctamente" },
          "404": { "description": "Artículo no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/editarArticulo/{id}": {
      "put": {
        "summary": "Editar artículo",
        "tags": ["Admin - Artículos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": { "type": "string", "maxLength": 150 },
                  "contenido": { "type": "string", "maxLength": 15000 },
                  "imagen": { "type": "string", "format": "binary" }
                },
                "required": ["titulo","contenido"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Artículo actualizado correctamente" },
          "404": { "description": "Artículo no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/getTodosLosUsuarios": {
      "get": {
        "summary": "Obtener todos los usuarios",
        "tags": ["Admin - Usuarios"],
        "responses": {
          "200": {
            "description": "Usuarios obtenidos correctamente",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "msg": "Aquí están todos los usuarios",
                  "data": [
                    { "id_usuario": 1, "nombre": "Esther", "email": "esther@mail.com", "id_rol": 2 },
                    { "id_usuario": 2, "nombre": "Juan", "email": "juan@mail.com", "id_rol": 1 }
                  ]
                }
              }
            }
          },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/buscarUsuario/{usuario}": {
      "get": {
        "summary": "Buscar usuario por nombre o email",
        "tags": ["Admin - Usuarios"],
        "parameters": [
          { "name": "usuario", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Usuario encontrado" },
          "400": { "description": "Falta el parámetro usuario" },
          "404": { "description": "Usuario no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/usuario/{id}": {
      "get": {
        "summary": "Obtener usuario por ID",
        "tags": ["Admin - Usuarios"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Usuario encontrado" },
          "404": { "description": "Usuario no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/admin/crearUsuario": {
      "post": {
        "summary": "Crear usuario",
        "tags": ["Admin - Usuarios"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string", "minLength": 2, "maxLength": 50 },
                  "email": { "type": "string", "format": "email", "maxLength": 100 },
                  "contrasenia": { "type": "string", "minLength": 1, "maxLength": 250 },
                  "id_rol": { "type": "integer", "minimum": 1 }
                },
                "required": ["nombre","email","contrasenia","id_rol"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Usuario registrado correctamente" },
          "400": { "description": "Faltan campos obligatorios" },
          "409": { "description": "Usuario existente" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/dashboard/{id}": {
      "get": {
        "summary": "Obtener artículo para usuario por ID",
        "tags": ["User - Artículos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Artículo encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/buscar": {
      "get": {
        "summary": "Buscar artículo por título",
        "tags": ["User - Artículos"],
        "parameters": [
          { "name": "titulo", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 150 } }
        ],
        "responses": {
          "200": {
            "description": "Artículo encontrado",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "msg": "Todo bien",
                  "data": [
                    { "id_articulo": 1, "titulo": "Nutrición y salud", "contenido": "Contenido completo..." }
                  ]
                }
              }
            }
          },
          "400": { "description": "Falta el título" },
          "404": { "description": "Artículo no encontrado" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/anadirFavoritos": {
      "post": {
        "summary": "Añadir artículo o receta a favoritos",
        "tags": ["User - Favoritos"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_articulo": { "type": "integer" },
                  "id_receta": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Artículo añadido a favoritos" },
          "400": { "description": "Faltan campos o ya existe" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/favoritos/{tipo}": {
      "get": {
        "summary": "Obtener favoritos de un usuario",
        "tags": ["User - Favoritos"],
        "parameters": [
          { "name": "tipo", "in": "path", "required": true, "schema": { "type": "string", "enum": ["articulo","receta"] } }
        ],
        "responses": {
          "200": {
            "description": "Favoritos obtenidos",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "msg": "TODO OK",
                  "data": [
                    { "id_articulo": 1, "titulo": "Nutrición y salud" },
                    { "id_receta": 3, "nombre": "Smoothie saludable" }
                  ]
                }
              }
            }
          },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/deleteFavorito/{id}/{tipo}": {
      "delete": {
        "summary": "Eliminar favorito de usuario",
        "tags": ["User - Favoritos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "tipo", "in": "path", "required": true, "schema": { "type": "string", "enum": ["articulo","receta"] } }
        ],
        "responses": {
          "201": { "description": "Favorito eliminado" },
          "400": { "description": "No existe en favoritos" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/anadirReceta": {
      "post": {
        "summary": "Añadir receta",
        "tags": ["User - Recetas"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "201": { "description": "Receta añadida correctamente" },
          "401": { "description": "Ya existe receta con ese título" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/user/traducir": {
      "post": {
        "summary": "Traducir texto usando DeepL",
        "tags": ["User - Traducción"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "text": {"type":"string"}, "source": {"type":"string"}, "target": {"type":"string"} }, "required":["text","source","target"] } } }
        },
        "responses": {
          "200": { "description": "Texto traducido correctamente" },
          "400": { "description": "Faltan campos" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/auth/signup": {
      "post": {
        "summary": "Registro de usuario",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "nombre_usuario": {"type":"string"}, "email":{"type":"string","format":"email"}, "password":{"type":"string"} }, "required":["nombre_usuario","email","password"] } } }
        },
        "responses": {
          "200": { "description": "Usuario registrado correctamente" },
          "400": { "description": "Faltan campos obligatorios" },
          "409": { "description": "Usuario existente" },
          "500": { "description": "Error del servidor" }
        }
      }
    },
 "/auth/login": {
      "post": {
        "summary": "Login de usuario",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "email":{"type":"string","format":"email"}, "contrasenia":{"type":"string"} }, "required":["email","contrasenia"] } } }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "msg": "Login de usuario",
                  "usuario": { "id_usuario": 1, "nombre": "Esther", "email": "esther@mail.com", "id_rol": 1 },
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI..."
                }
              }
            }
          },
          "400": { "description": "Usuario no encontrado" },
          "401": { "description": "Contraseña incorrecta" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

    "/auth/renew": {
      "post": {
        "summary": "Renovar token",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Token renovado correctamente" },
          "500": { "description": "Error del servidor" }
        }
      }
    },

